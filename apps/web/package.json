{
  "name": "@equityos/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "next typegen && tsc --noEmit && tsc --noEmit -p tsconfig.test.json",
    "test": "bun test",
    "test:e2e": "playwright test",
    "seed:local": "bun --conditions=react-server scripts/seed-local.ts",
    "seed:public": "bun --conditions=react-server scripts/seed-public.ts",
    "record:registry": "bun --conditions=react-server scripts/record-registry.ts",
    "record:balances": "bun --conditions=react-server scripts/record-balances.ts",
    "record:api-examples": "bun --conditions=react-server scripts/record-api-examples.ts",
    "test:integration": "INTEGRATION_TESTS=1 bun test test/registry/integration.test.ts",
    "test:e2e:chain": "playwright test --config playwright.chain.config.ts"
  },
  "dependencies": {
    "@base-org/account": "2.6.0",
    "@equityos/contracts-abi": "workspace:*",
    "@equityos/core": "workspace:*",
    "@fontsource-variable/ibm-plex-sans": "5.3.0",
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@tanstack/react-query": "5.108.2",
    "@wagmi/core": "3.6.9",
    "@walletconnect/ethereum-provider": "2.26.0",
    "next": "16.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "0.0.1",
    "viem": "2.58.4",
    "wagmi": "3.7.11"
  },
  "devDependencies": {
    "@equityos/sdk": "workspace:*",
    "@playwright/test": "1.65.1",
    "@tailwindcss/postcss": "4.3.5",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "ajv": "8.20.0",
    "tailwindcss": "4.3.5"
  }
}
