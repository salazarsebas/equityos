{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:equityos:schema:index:1",
  "title": "equityos.index/1",
  "description": "Methodology spec of an EquityOS index. Structural rules only: a conforming validator also enforces the rules listed in $comment.",
  "$comment": "Not expressible here and required for validity: (1) universe.tokens is strictly ascending; (2) pricing.feeds has the length of universe.tokens; (3) weighting.weightsBps has the length of universe.tokens; (4) weighting.weightsBps sums to 10000; (5) with fixed weighting, every weight is at most constraints.maxWeightBps and at least constraints.minWeightBps; (6) with equal weighting, constraints.maxWeightBps times the number of tokens is at least 10000 and constraints.minWeightBps times the number of tokens is at most 10000; (7) description is in Unicode Normalization Form C and has no lone surrogate; (8) the RFC 8785 canonical form is at most 8192 bytes; (9) every number is an integer written without fraction or exponent, which the canonical form guarantees.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "calc",
    "chainId",
    "description",
    "name",
    "pricing",
    "rebalance",
    "schema",
    "slug",
    "universe",
    "weighting"
  ],
  "properties": {
    "schema": { "const": "equityos.index/1" },
    "calc": { "const": "equityos.calc/1" },
    "chainId": { "$ref": "#/$defs/positiveInteger" },
    "name": { "type": "string", "pattern": "^[ -~]{1,64}$" },
    "slug": { "type": "string", "pattern": "^[a-z0-9]([a-z0-9-]{0,30}[a-z0-9])?$" },
    "description": { "type": "string" },
    "universe": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tokens", "type"],
      "properties": {
        "type": { "const": "static" },
        "tokens": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/address",
            "not": { "const": "0x0000000000000000000000000000000000000000" }
          }
        }
      }
    },
    "weighting": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type"],
          "properties": {
            "type": { "const": "equal" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "weightsBps"],
          "properties": {
            "type": { "const": "fixed" },
            "weightsBps": {
              "type": "array",
              "items": { "$ref": "#/$defs/bps" }
            }
          }
        }
      ]
    },
    "constraints": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "maxWeightBps": { "$ref": "#/$defs/bps" },
        "minWeightBps": { "$ref": "#/$defs/bps" }
      }
    },
    "pricing": {
      "type": "object",
      "additionalProperties": false,
      "required": ["feeds", "source"],
      "properties": {
        "source": { "const": "chainlink-aggregator-v3" },
        "feeds": {
          "type": "array",
          "items": { "$ref": "#/$defs/address" }
        }
      }
    },
    "rebalance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["driftThresholdBps", "minIntervalSeconds", "trigger"],
      "properties": {
        "trigger": { "const": "drift" },
        "driftThresholdBps": { "$ref": "#/$defs/bps" },
        "minIntervalSeconds": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 }
      }
    },
    "parent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["chainId", "indexId", "registry", "specHash", "version"],
      "properties": {
        "chainId": { "$ref": "#/$defs/positiveInteger" },
        "registry": { "$ref": "#/$defs/address" },
        "indexId": { "$ref": "#/$defs/bytes32" },
        "version": { "type": "integer", "minimum": 1, "maximum": 4294967295 },
        "specHash": { "$ref": "#/$defs/bytes32" }
      }
    }
  },
  "$defs": {
    "address": { "type": "string", "pattern": "^0x[0-9a-f]{40}$" },
    "bytes32": { "type": "string", "pattern": "^0x[0-9a-f]{64}$" },
    "bps": { "type": "integer", "minimum": 1, "maximum": 10000 },
    "positiveInteger": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 }
  }
}
