# Copy to .env.local for local development and uncomment what you need. Never commit a file with real values.

# Public origin of the site, used for canonical URLs, robots.txt and the sitemap. Defaults to localhost.
# NEXT_PUBLIC_SITE_URL=https://example.org

# Base mainnet JSON-RPC endpoint (http or https) read by the server-side market data layer. Read-only.
# Required when NODE_ENV is "production": the server fails with a "missing_configuration" error without it.
# When unset outside production, the public endpoint https://mainnet.base.org is used. It is rate limited and
# best effort, so it is suitable for local development only.
# BASE_RPC_URL=https://your-base-mainnet-rpc.example/v1/your-key

# Chain the index registry is read from: 8453 (Base mainnet, the default), 84532 (Base Sepolia) or 31337 (a
# local Anvil node). The registry is not deployed on Base mainnet or Base Sepolia yet: on those chains every
# registry read reports "registry_not_deployed". Market data is always read from Base mainnet.
# EQUITYOS_CHAIN_ID=31337

# JSON-RPC endpoint (http or https) of the registry chain when EQUITYOS_CHAIN_ID is 84532 or 31337. Read-only.
# Defaults to http://127.0.0.1:8545 for 31337. For 84532 it defaults to the public endpoint
# https://sepolia.base.org outside production and is required in production. Base mainnet uses BASE_RPC_URL.
# EQUITYOS_RPC_URL=http://127.0.0.1:8545

# Maximum number of blocks per eth_getLogs request when scanning registry events. Defaults to 2000. Lower it
# for a provider that rejects ranges that wide.
# EQUITYOS_LOG_CHUNK_BLOCKS=2000

# Client id sent in the x-client-id header to the KyberSwap aggregator API, which quotes execution plans. It is
# not a secret and no API key is used. Defaults to "equityos". Letters, digits, dots, hyphens and underscores.
# KYBERSWAP_CLIENT_ID=equityos

# Directory of a recorded asset list and block (asset-list.json and onchain.json) to replay instead of reading
# the live sources, with the clock fixed at the recorded block. Used by the browser tests. A deployment refuses it:
# with VERCEL_ENV set, or in a production build without EQUITYOS_REPLAY_FOR_TESTS=1, the server does not start
# and every request answers "service_misconfigured".
# MARKET_REPLAY_DIR=test/fixtures/market

# Directory of a recorded index registry (registry.json) to replay instead of reading a chain. It replaces
# EQUITYOS_CHAIN_ID and EQUITYOS_RPC_URL. Used by the browser tests, and refused like MARKET_REPLAY_DIR. While it
# is set, the pages and the API say that they serve the example indexes of a development chain.
# REGISTRY_REPLAY_DIR=test/fixtures/registry

# Test-only: "1" lets a production build (next start) replay the two recordings above. Only the Playwright
# configuration of the smoke tests sets it. It has no effect on a Vercel deployment. Never set it anywhere else.
# EQUITYOS_REPLAY_FOR_TESTS=1

# JSON-RPC endpoints (http or https) the browser reads through the wallet layer. They are public: the values are
# compiled into the browser bundle at build time, so use keys that are restricted to your site's origin.
# When unset, the public endpoints are used: https://mainnet.base.org and https://sepolia.base.org. They are rate
# limited and best effort, so they are suitable for local development only. A production deployment must set both.
# NEXT_PUBLIC_BASE_RPC_URL=https://your-base-mainnet-rpc.example/v1/your-public-key
# NEXT_PUBLIC_BASE_SEPOLIA_RPC_URL=https://your-base-sepolia-rpc.example/v1/your-public-key

# Endpoint of a local Anvil node (chain id 31337). The chain exists in development builds only.
# Defaults to http://127.0.0.1:8545.
# NEXT_PUBLIC_ANVIL_RPC_URL=http://127.0.0.1:8545

# WalletConnect project id. When unset, WalletConnect is not offered in the connect dialog at all.
# NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=
